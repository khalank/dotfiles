            background "#080d12"
            emphasis_0 "#e99059"
            emphasis_1 "#90c0e9"
            emphasis_2 "#5990c0"
            emphasis_3 "#4b9797"
        }
        multiplayer_user_colors {
            player_1 "#dd77ee"
            player_2 "#5599ff"
            player_3 "#ffdd88"
            player_4 "#77cc66"
            player_5 "#ff5577"
            player_6 "#bb55dd"
            player_7 "#0066dd"
            player_8 "#ee9944"
